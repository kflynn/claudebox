#!/usr/bin/env python3
"""Push "OK", "Failed", or "Question" to Pushover.

Usage:
    ./pushover.py ok
    ./pushover.py failed
    ./pushover.py question
    ./pushover.py failed "build 1234 blew up"   # optional extra detail
    ./pushover.py --help

Credentials come from the environment:
    PUSHOVER_TOKEN  - your Pushover *application* API token
    PUSHOVER_USER   - your Pushover *user* key (or a group key)
"""

import json
import os
import sys
import urllib.error
import urllib.parse
import urllib.request

API_URL = "https://api.pushover.net/1/messages.json"


def usage():
    if __doc__:
        return(__doc__.strip())
    else:
        return("Usage: ./pushover.py <ok|failed|question> [detail]")


def get_config_var(name, path=None):
    value = os.environ.get(name)

    if not value:
        if path:
            path = os.path.expanduser(path)

            if os.path.exists(path):
                with open(path) as f:
                    value = f.read().strip()

    if not value:
        sys.exit(f"{name}: missing, set in the environment or in {path}")

    return value


def push(status, detail=None):
    token = get_config_var("PUSHOVER_TOKEN", "~/.pushover-app-token")
    user = get_config_var("PUSHOVER_USER", "~/.pushover-user")

    if not token or not user:
        sys.exit("Set PUSHOVER_TOKEN and PUSHOVER_USER in the environment.")

    status = status.lower()
    if status in ("ok", "pass", "passed", "success", "0"):
        message, priority = "OK", 0
    elif status in ("question", "ask"):
        message, priority = "Question", 0
    elif status in ("fail", "failed", "error", "1"):
        message, priority = "Failed", 1
    else:
        message, priority = "???", 1

    payload = {
        "token": token,
        "user": user,
        "message": message,
        "priority": priority,
    }
    if detail:
        payload["message"] += f"\n{detail}"

    data = urllib.parse.urlencode(payload).encode()
    req = urllib.request.Request(API_URL, data=data)
    try:
        with urllib.request.urlopen(req, timeout=10) as resp:
            body = json.load(resp)
    except urllib.error.HTTPError as e:
        sys.exit(f"Pushover rejected the request: {e.code} {e.read().decode()}")
    except urllib.error.URLError as e:
        sys.exit(f"Could not reach Pushover: {e.reason}")

    if body.get("status") != 1:
        sys.exit(f"Pushover error: {body}")
    print(f"sent: {payload['message'].splitlines()[0]}")


if __name__ == "__main__":
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help"):
        print(usage())

        sys.exit(0)

    status = sys.argv[1]
    detail = " ".join(sys.argv[2:]) if len(sys.argv) > 2 else ""

    push(status, detail)
